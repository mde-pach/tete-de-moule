---
import BaseLayout from "../layouts/BaseLayout.astro";
import { INSTRUMENTS } from "../lib/instruments.ts";
---

<BaseLayout
  title="Tête de Moule — les doigtés sur ta partition, automatiquement"
  description="Dépose une partition MuseScore, choisis ton instrument, et récupère ta partie seule avec les doigtés et le nom des notes, prête à imprimer."
>
  <section class="hero">
    <div class="shell">
      <p class="eyebrow">Pour les fanfares</p>
      <h1>Les doigtés sur ta partition,<br />sans le crayon.</h1>
      <p class="hero__lead">
        Dépose le fichier MuseScore que ton chef t'a envoyé. Choisis ton
        instrument une fois pour toutes. Récupère ta partie seule, doigtée note
        par note, prête à poser sur le pupitre.
      </p>
    </div>
  </section>

  <section class="section" id="atelier">
    <div class="shell">
      <div class="workbench">
        <div class="panel stack" style="--gap: 0">
          <h2 class="ui" style="font-size:1.1rem">Réglages</h2>

          <label class="field">
            <span class="field__label">Ton instrument</span>
            <select id="instrument">
              {INSTRUMENTS.map((instrument) => (
                <option value={instrument.id}>{instrument.label}</option>
              ))}
            </select>
            <span class="field__hint" id="instrument-hint">Retenu pour la prochaine fois.</span>
          </label>

          <label class="field">
            <span class="field__label">Comment tu lis</span>
            <select id="reading"></select>
          </label>

          <label class="field" id="valves-field">
            <span class="field__label">Nombre de pistons</span>
            <select id="valves"></select>
          </label>

          <div class="field">
            <span class="field__label">Sur la partition</span>
            <div class="toggles">
              <label class="toggle"><input type="checkbox" id="show-fingerings" checked /> Doigtés</label>
              <label class="toggle"><input type="checkbox" id="show-note-names" checked /> Noms des notes</label>
              <label class="toggle"><input type="checkbox" id="show-measure-numbers" checked /> N° de mesure</label>
            </div>
          </div>

          <label class="field hidden" id="part-field">
            <span class="field__label">Ta partie</span>
            <select id="part"></select>
            <span class="field__hint" id="part-hint"></span>
          </label>
        </div>

        <div class="stack" style="--gap: 1rem">
          <div id="dropzone" class="dropzone" tabindex="0" role="button"
               aria-label="Choisir une partition MuseScore">
            <p class="dropzone__title">Dépose ta partition ici</p>
            <p class="muted small" style="margin:0">Fichier MuseScore (.mscz) — ou clique pour le choisir</p>
            <input type="file" id="file" accept=".mscz,.mscx" class="hidden" />
          </div>

          <div id="messages" class="stack" style="--gap: 0.6rem"></div>

          <div id="actions" class="button-row hidden">
            <button class="button button--accent" id="download" type="button">Télécharger le PDF</button>
            <button class="button button--quiet" id="reset" type="button">Changer de partition</button>
            <span class="small muted" id="status"></span>
          </div>

          <div id="preview" class="preview hidden">
            <div class="preview__pages" id="pages"></div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section" id="a-venir">
    <div class="shell">
      <div class="section__head">
        <h2>La suite</h2>
        <p class="muted">
          L'atelier des doigtés est la première brique. D'autres arrivent, au
          rythme des répétitions.
        </p>
      </div>
      <div class="grid-cards">
        <article class="card">
          <h3>Tableau des doigtés</h3>
          <p class="muted small" style="margin:0">
            Toutes les combinaisons sur l'ambitus complet, et la série harmonique
            de chaque doigté — un doigté, plusieurs notes.
          </p>
        </article>
        <article class="card card--soon">
          <h3>Le répertoire</h3>
          <p class="small" style="margin:0">Les morceaux de la fanfare au même endroit, avec les parties de chacun.</p>
        </article>
        <article class="card card--soon">
          <h3>Écouter sa partie</h3>
          <p class="small" style="margin:0">Jouer la ligne seule, ou par-dessus le reste, pour la travailler chez soi.</p>
        </article>
      </div>
    </div>
  </section>

  <script>
    import "../scripts/app.ts";
  </script>
</BaseLayout>
