---
import Base from '../layouts/Base.astro';
import { INSTRUMENTS } from '../lib/instruments';

const familles = [...new Set(INSTRUMENTS.map((i) => i.famille))];
---

<Base
  titre="Tête de Moule — les doigtés écrits sur ta partition"
  description="Dépose ta partition MuseScore, choisis ta ligne, récupère un PDF avec les doigtés sous chaque note. Pour euphonium, trompette, bugle, alto, soubasse."
>
  <!-- Réglage d'instrument, ouvert depuis la pastille d'en-tête -->
  <div class="panneau" id="panneau-instrument" hidden>
    <div class="contenu panneau__corps">
      <div class="champ">
        <label for="choix-instrument">Mon instrument</label>
        <select id="choix-instrument">
          {
            familles.map((famille) => (
              <optgroup label={famille}>
                {INSTRUMENTS.filter((i) => i.famille === famille).map((i) => (
                  <option value={i.id}>{i.nom}</option>
                ))}
              </optgroup>
            ))
          }
        </select>
      </div>
      <div class="champ">
        <label for="choix-pistons">Pistons</label>
        <select id="choix-pistons"></select>
      </div>
      <p class="panneau__note">
        Retenu pour la prochaine fois. Le nombre de pistons change les doigtés graves&nbsp;:
        avec un quatrième, <b>1-3</b> devient <b>4</b>.
      </p>
    </div>
  </div>

  <section class="accroche contenu" id="accroche">
    <h1>Les doigtés, écrits pour toi.</h1>
    <p class="accroche__sous-titre">
      Dépose la partition que t'a donnée la fanfare, dis-nous quelle ligne est la tienne, et
      repars avec un PDF prêt à poser sur le pupitre.
    </p>

    <label class="portee" id="depot" for="fichier">
      <input type="file" id="fichier" accept=".mscz,.mscx" class="hors-ecran" />
      <span class="portee__lignes" aria-hidden="true"></span>
      <span class="portee__etiquette">
        <span class="portee__titre" id="depot-titre">Dépose ta partition ici</span>
        <span class="portee__detail" id="depot-detail">ou clique pour choisir un fichier .mscz</span>
      </span>
    </label>

    <p class="alerte" id="alerte" role="alert" hidden></p>
  </section>

  <section class="etape contenu" id="etape-ligne" hidden>
    <div class="etape__entete">
      <h2>Ta ligne</h2>
      <p class="etape__aide" id="resume-fichier"></p>
    </div>
    <div class="lignes" id="lignes" role="radiogroup" aria-label="Choisir la portée à traiter"></div>
  </section>

  <section class="etape contenu" id="etape-reglages" hidden>
    <div class="etape__entete">
      <h2>Comment tu la lis</h2>
    </div>
    <div class="reglages">
      <div class="champ">
        <label for="choix-lecture">Clé</label>
        <select id="choix-lecture"></select>
      </div>
      <div class="bascules">
        <label class="interrupteur">
          <input type="checkbox" id="bascule-doigtes" checked />
          <span>Doigtés sous les notes</span>
        </label>
        <label class="interrupteur">
          <input type="checkbox" id="bascule-noms" checked />
          <span>Noms des notes</span>
        </label>
      </div>
    </div>
  </section>

  <section class="etape contenu" id="etape-apercu" hidden>
    <div class="etape__entete etape__entete--action">
      <h2>Ta partition</h2>
      <button type="button" class="bouton bouton--principal" id="bouton-pdf" disabled>
        Télécharger le PDF
      </button>
    </div>
    <p class="etape__aide" id="etat-gravure" aria-live="polite"></p>
    <div class="feuilles" id="feuilles"></div>
  </section>
</Base>

<style>
  /* --- accroche --------------------------------------------------------- */

  .accroche {
    padding-top: clamp(2.5rem, 7vw, 4.5rem);
  }

  .accroche__sous-titre {
    font-size: clamp(1.05rem, 2.2vw, 1.25rem);
    color: var(--encre-douce);
    margin-top: 1.1rem;
    max-width: 46ch;
  }

  /* Le dépôt de fichier est dessiné comme une portée : c'est l'objet le plus
     caractéristique du sujet, autant s'en servir plutôt que d'un rectangle. */
  .portee {
    position: relative;
    display: block;
    margin-top: clamp(1.5rem, 4vw, 2.5rem);
    padding: clamp(3rem, 8vw, 4.5rem) 1.5rem;
    border-radius: var(--arrondi);
    cursor: pointer;
    isolation: isolate;
    transition: transform 160ms ease;
  }

  .portee__lignes {
    position: absolute;
    inset: 0;
    z-index: -1;
    background-image: repeating-linear-gradient(
      to bottom,
      transparent 0,
      transparent calc(1.75rem - 1px),
      var(--trait) calc(1.75rem - 1px),
      var(--trait) 1.75rem
    );
    background-position: center;
    background-size: 100% 8.75rem;
    background-repeat: no-repeat;
    transition: filter 200ms ease;
  }

  .portee__etiquette {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.3rem;
    text-align: center;
    background: var(--nacre);
    padding: 0.9rem 1.4rem;
    width: fit-content;
    max-width: 100%;
    margin-inline: auto;
    border-radius: 6px;
  }

  .portee__titre {
    font-family: var(--serif);
    font-weight: 700;
    font-size: clamp(1.15rem, 3vw, 1.5rem);
    letter-spacing: -0.015em;
  }

  .portee__detail {
    font-size: 0.92rem;
    color: var(--encre-douce);
  }

  .portee:hover .portee__lignes,
  .portee:focus-within .portee__lignes {
    filter: brightness(0.94);
  }

  .portee.est-survolee {
    transform: scale(1.008);
  }

  .portee.est-survolee .portee__etiquette {
    box-shadow: 0 0 0 2px var(--flamboyant);
  }

  .portee.est-chargee {
    cursor: default;
  }

  .alerte {
    margin-top: 1.25rem;
    padding: 0.85rem 1.1rem;
    border-radius: var(--arrondi);
    background: #fdeee7;
    border: 1px solid #f3c3ab;
    color: #8c2f08;
    font-size: 0.95rem;
    max-width: 60ch;
  }

  /* --- panneau instrument ---------------------------------------------- */

  .panneau {
    background: var(--nacre-creuse);
    border-bottom: 1px solid var(--trait);
  }

  .panneau__corps {
    display: flex;
    flex-wrap: wrap;
    gap: 1.25rem 2rem;
    align-items: flex-end;
    padding: 1.35rem 0;
  }

  .panneau__note {
    margin: 0;
    font-size: 0.88rem;
    color: var(--encre-douce);
    flex: 1 1 24ch;
  }

  .panneau__note b {
    font-weight: 600;
    color: var(--encre);
  }

  /* --- étapes ----------------------------------------------------------- */

  .etape {
    margin-top: clamp(2.5rem, 6vw, 3.75rem);
  }

  .etape__entete {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.5rem;
    align-items: baseline;
    padding-bottom: 0.75rem;
    border-bottom: 2px solid var(--encre);
    margin-bottom: 1.25rem;
  }

  .etape__entete--action {
    align-items: center;
    justify-content: space-between;
  }

  .etape__aide {
    margin: 0;
    font-size: 0.92rem;
    color: var(--encre-douce);
  }

  .champ {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .champ label {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--encre-douce);
  }

  /* --- réglages --------------------------------------------------------- */

  .reglages {
    display: flex;
    flex-wrap: wrap;
    gap: 1.25rem 2.5rem;
    align-items: flex-end;
  }

  .bascules {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.5rem;
    padding-bottom: 0.55rem;
  }

  @media (max-width: 34rem) {
    .etape__entete--action {
      align-items: flex-start;
      flex-direction: column;
    }
    .etape__entete--action .bouton {
      width: 100%;
    }
  }
</style>

<style is:global>
  /* --- liste des portées ------------------------------------------------ */

  .lignes {
    display: grid;
    gap: 2px;
  }

  .ligne {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 0.3rem 1rem;
    align-items: baseline;
    width: 100%;
    text-align: left;
    font: inherit;
    color: inherit;
    background: transparent;
    border: 0;
    border-left: 3px solid transparent;
    padding: 0.7rem 0.9rem;
    cursor: pointer;
    border-radius: 4px;
    transition: background-color 120ms ease;
  }

  .ligne:hover {
    background: var(--nacre-creuse);
  }

  .ligne[aria-checked='true'] {
    background: var(--papier);
    border-left-color: var(--flamboyant);
  }

  .ligne__nom {
    font-weight: 600;
  }

  .ligne__marque {
    font-weight: 400;
    color: var(--flamboyant-sombre);
    font-size: 0.85rem;
    margin-left: 0.5rem;
  }

  .ligne__detail {
    grid-column: 1;
    font-size: 0.88rem;
    color: var(--encre-douce);
  }

  .ligne__ambitus {
    grid-row: 1 / span 2;
    grid-column: 2;
    align-self: center;
    font-size: 0.85rem;
    color: var(--encre-douce);
    white-space: nowrap;
  }

  /* --- aperçu ----------------------------------------------------------- */

  .feuilles {
    display: grid;
    gap: 1.5rem;
    margin-top: 1.25rem;
  }

  .feuille {
    background: var(--papier);
    border: 1px solid var(--trait);
    border-radius: 4px;
    box-shadow: 0 2px 10px rgb(26 21 36 / 0.06);
    overflow: hidden;
  }

  .feuille svg {
    display: block;
    width: 100%;
    height: auto;
  }

  .feuille--attente {
    aspect-ratio: 210 / 297;
    display: grid;
    place-items: center;
    color: var(--encre-douce);
    font-size: 0.92rem;
    box-shadow: none;
  }

</style>

<script>
  import { demarrer } from '../scripts/app';
  demarrer();
</script>
