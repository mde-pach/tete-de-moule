---
// L'en-tête porte la pastille d'instrument : c'est le seul réglage qu'on garde
// d'une visite à l'autre, donc il doit être visible et modifiable partout.
import { lien } from '../lib/chemin';
---

<header class="entete">
  <div class="contenu entete__grille">
    <a class="marque" href={lien()}>
      <svg class="marque__signe" viewBox="0 0 28 24" aria-hidden="true">
        <path
          d="M2 4h24M2 9h24M2 14h24M2 19h24"
          stroke="currentColor"
          stroke-width="1.1"
          opacity=".38"></path>
        <path
          d="M4 18c0-4.4 3.4-8 7.6-8 3 0 5 1.7 5 4.1 0 3.2-3.3 5.2-7 5.2-2.4 0-4-.5-5.6-1.3Z"
          fill="currentColor"></path>
        <path d="M16.6 14.1V3.4l7.4 1.6" stroke="currentColor" stroke-width="2.1" fill="none"
        ></path>
      </svg>
      <span class="marque__nom">Tête de Moule</span>
    </a>

    <button
      type="button"
      class="pastille"
      id="pastille-instrument"
      aria-expanded="false"
      aria-controls="panneau-instrument"
    >
      <span class="pastille__valeur" id="pastille-valeur">Choisir mon instrument</span>
      <svg viewBox="0 0 10 6" aria-hidden="true" class="pastille__fleche">
        <path d="M1 1l4 4 4-4" stroke="currentColor" stroke-width="1.4" fill="none"></path>
      </svg>
    </button>
  </div>
</header>

<style>
  .entete {
    background: var(--moule);
    color: #fff;
    position: sticky;
    top: 0;
    z-index: 20;
  }

  .entete__grille {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 3.75rem;
  }

  .marque {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    color: inherit;
    text-decoration: none;
  }

  .marque__signe {
    width: 30px;
    height: 26px;
    flex: none;
  }

  .marque__nom {
    font-family: var(--serif);
    font-weight: 800;
    font-size: 1.22rem;
    letter-spacing: -0.02em;
  }

  .pastille {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font: inherit;
    font-size: 0.92rem;
    font-weight: 500;
    color: #fff;
    background: rgb(255 255 255 / 0.12);
    border: 1px solid rgb(255 255 255 / 0.24);
    border-radius: 999px;
    padding: 0.35rem 0.85rem;
    cursor: pointer;
    transition: background-color 120ms ease;
  }

  .pastille:hover {
    background: rgb(255 255 255 / 0.22);
  }

  .pastille__fleche {
    width: 10px;
    height: 6px;
    opacity: 0.8;
    transition: transform 160ms ease;
  }

  .pastille[aria-expanded='true'] .pastille__fleche {
    transform: rotate(180deg);
  }

  :global(:focus-visible) {
    outline-color: #fff;
  }

  @media (max-width: 30rem) {
    .marque__nom {
      font-size: 1.05rem;
    }
    .pastille {
      font-size: 0.85rem;
    }
  }
</style>
